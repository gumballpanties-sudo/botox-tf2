// Just enough of Qt for Krita's pigment blend-mode headers to compile standalone.
#pragma once
#include <cstdint>
#include <cmath>
#include <algorithm>

typedef int8_t   qint8;
typedef uint8_t  quint8;
typedef int16_t  qint16;
typedef uint16_t quint16;
typedef int32_t  qint32;
typedef uint32_t quint32;
typedef int64_t  qint64;
typedef uint64_t quint64;
typedef double   qreal;
typedef unsigned int uint;

template <typename T> constexpr inline const T& qMin(const T& a, const T& b) { return (a < b) ? a : b; }
template <typename T> constexpr inline const T& qMax(const T& a, const T& b) { return (a < b) ? b : a; }
template <typename T> constexpr inline const T& qBound(const T& lo, const T& v, const T& hi) { return qMax(lo, qMin(hi, v)); }
template <typename T> constexpr inline T qAbs(const T& t) { return t >= 0 ? t : -t; }

// qglobal.h / qnumeric.h definitions, verbatim semantics
inline bool qFuzzyCompare(double p1, double p2) { return qAbs(p1 - p2) * 1000000000000. <= qMin(qAbs(p1), qAbs(p2)); }
inline bool qFuzzyCompare(float p1, float p2)   { return qAbs(p1 - p2) * 100000.f <= qMin(qAbs(p1), qAbs(p2)); }
inline bool qFuzzyIsNull(double d) { return qAbs(d) <= 0.000000000001; }
inline bool qFuzzyIsNull(float f)  { return qAbs(f) <= 0.00001f; }

#define Q_UNUSED(x) (void)x;
#define Q_ASSERT(x)
